scenario 17 one-record-only
cfg records 1 1
cfg ops 4 r:1:1:0 r:2:1:0 x:1:0:0 r:2:1:0
op 0 r -> Success
records out 1 1:1:PublishSend
records in 1 0:0:Null
op 1 r -> NoMemory
records out 1 1:1:PublishSend
records in 1 0:0:Null
op 2 x -> Success
records out 1 0:0:Null
records in 1 0:0:Null
op 3 r -> Success
records out 1 2:1:PublishSend
records in 1 0:0:Null
end scenario 17
scenario 18 incoming-records-exhausted
cfg records 4 2
cfg ops 3 p:1:2:1 p:2:2:1 p:3:2:1
op 0 p -> Success PubRecSend
records out 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
records in 2 1:2:PubRecSend 0:0:Null
op 1 p -> Success PubRecSend
records out 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
records in 2 1:2:PubRecSend 2:2:PubRecSend
op 2 p -> NoMemory Null
records out 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
records in 2 1:2:PubRecSend 2:2:PubRecSend
end scenario 18
scenario 19 pubrec-reordering-on-a-full-array
cfg records 4 4
cfg ops 14 r:1:2:0 p:1:2:0 r:2:2:0 p:2:2:0 r:3:2:0 p:3:2:0 r:4:2:0 p:4:2:0 a:1:1:1 a:2:1:1 C:0:0:0 R:0:0:0 R:0:0:0 R:0:0:0
op 0 r -> Success
records out 4 1:2:PublishSend 0:0:Null 0:0:Null 0:0:Null
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 1 p -> Success PubRecPending
records out 4 1:2:PubRecPending 0:0:Null 0:0:Null 0:0:Null
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 2 r -> Success
records out 4 1:2:PubRecPending 2:2:PublishSend 0:0:Null 0:0:Null
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 3 p -> Success PubRecPending
records out 4 1:2:PubRecPending 2:2:PubRecPending 0:0:Null 0:0:Null
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 4 r -> Success
records out 4 1:2:PubRecPending 2:2:PubRecPending 3:2:PublishSend 0:0:Null
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 5 p -> Success PubRecPending
records out 4 1:2:PubRecPending 2:2:PubRecPending 3:2:PubRecPending 0:0:Null
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 6 r -> Success
records out 4 1:2:PubRecPending 2:2:PubRecPending 3:2:PubRecPending 4:2:PublishSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 7 p -> Success PubRecPending
records out 4 1:2:PubRecPending 2:2:PubRecPending 3:2:PubRecPending 4:2:PubRecPending
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 8 a -> Success PubRelSend
records out 4 2:2:PubRecPending 3:2:PubRecPending 4:2:PubRecPending 1:2:PubRelSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 9 a -> Success PubRelSend
records out 4 3:2:PubRecPending 4:2:PubRecPending 1:2:PubRelSend 2:2:PubRelSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 10 C -> cursor=0
records out 4 3:2:PubRecPending 4:2:PubRecPending 1:2:PubRelSend 2:2:PubRelSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 11 R -> 1 PubRelSend cursor=3
records out 4 3:2:PubRecPending 4:2:PubRecPending 1:2:PubRelSend 2:2:PubRelSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 12 R -> 2 PubRelSend cursor=4
records out 4 3:2:PubRecPending 4:2:PubRecPending 1:2:PubRelSend 2:2:PubRelSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
op 13 R -> 0 Null cursor=4
records out 4 3:2:PubRecPending 4:2:PubRecPending 1:2:PubRelSend 2:2:PubRelSend
records in 4 0:0:Null 0:0:Null 0:0:Null 0:0:Null
end scenario 19
